rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.keys().size() == 2 &&
             data.email is string && data.email.size() <= 200 &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && (
        // Action: Update email
        incoming().diff(existing()).affectedKeys().hasOnly(['email']) &&
        incoming().email is string && incoming().email.size() <= 200
      );
      allow delete: if false; // Users cannot be deleted directly from client

      match /documents/{documentId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /books/{bookId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
