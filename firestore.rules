rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.keys().hasOnly(['email', 'createdAt', 'fullName', 'displayName', 'phoneNumber']) &&
             data.email is string && data.email.size() <= 200 &&
             (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 200)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'fullName', 'displayName', 'phoneNumber']) &&
        (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 200)) &&
        (!('fullName' in incoming()) || (incoming().fullName is string && incoming().fullName.size() <= 200)) &&
        (!('displayName' in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 200)) &&
        (!('phoneNumber' in incoming()) || (incoming().phoneNumber is string && incoming().phoneNumber.size() <= 50))
      );
      allow delete: if false; // Users cannot be deleted directly from client

      match /documents/{documentId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /books/{bookId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
